{
  "name": "jonathanburnhams-com",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node ./scripts/fetch-strava-data.js",
    "build": "npm run prebuild && npm run type-check && vite build && node ./scripts/inject-build-timestamp.js && node ./scripts/build-race-pages.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "node node_modules/typescript7/bin/tsc --noEmit"
  },
  "dependencies": {
    "@mapbox/polyline": "^1.2.1",
    "@tanstack/react-query": "^5.108.4",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "strata-react": "^1.3.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.1",
    "@types/leaflet": "^1.9.21",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/ui": "^5.1.2",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "global-jsdom": "^31.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^31.0.1",
    "leaflet-node": "^2.0.25",
    "msw": "^3.0.7",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript7": "npm:typescript@~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
